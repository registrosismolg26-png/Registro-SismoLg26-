// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registro {
  id                   String    @id @default(uuid())
  parroquia            String
  sector               String
  comunidad            String
  direccionExacta      String
  nombreApellido       String
  cedula               String    @unique
  jefeFamilia          String    // "SI" / "NO"
  genero               String    // "MASCULINO" / "FEMENINO"
  fechaNacimiento      DateTime
  edad                 Int
  perteneceNucleo      String    // "SI" / "NO"
  cedulaJefeFamilia    String?
  estadoFisico         String    // "ILESO" / "LECIONADO"
  patologia            String    // "SI" / "NO"
  patologiaDescripcion String?
  gpsLat               Float?
  gpsLng               Float?
  telefono             String?
  cuarto               String?   // Assigned room: "EDIFICIO 1 SALON N"
  medicamentos         Json?     @default("[]") // LEGADO (congelado): [{nombre, dosis, periodo}] — reemplazado por medicamentoIds
  // NOTA: patologiaDescripcion (arriba) queda CONGELADO como respaldo; el modelo por-ID usa patologiaIds/medicamentoIds.
  patologiaIds         Json?     @default("[]") // ID-nativo: ["<PatologiaId>", ...]
  medicamentoIds       Json?     @default("[]") // ID-nativo: [{ id: "<MedicamentoPredefinidoId>", dosis, periodo }]
  retirado             String    @default("NO") // "SI" / "NO"
  retiradoRazon        String?
  retiradoFecha        DateTime?
  createdAt            DateTime  @default(now())
  syncedAt             DateTime? @default(now())
  intermitente         String    @default("NO") // "SI" or "NO"
  motivoIntermitente   String?   // Required when intermitente = "SI"
  refugio              String
}

model Padron {
  cedula          String   @id // Ej: "12345678"
  nacionalidad    String   // "V" / "E"
  nombreCompleto  String
  sexo            String   // "M" / "F"
  fechaNacimiento DateTime
  parroquia       String   // Parroquia de votación

  @@index([parroquia])
}
model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  nombre                String
  password              String
  role                  String   // "MASTER" | "ADMIN" | "REGISTRADOR" | "VISUALIZADOR"
  campamentoTransitorio String
  createdAt             DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  keysAuth  String
  keysP256dh String
  createdAt DateTime @default(now())
}

model CustomRoom {
  id        String   @id @default(uuid())
  name      String
  refugio   String
  capacidad Int      @default(18) // camas disponibles en el salón
  createdAt DateTime @default(now())

  @@unique([name, refugio])
}

model Refugio {
  id        String   @id @default(uuid())
  nombre    String   @unique
  ubicacion String?  // URL de Google Maps del refugio (para el reporte)
  createdAt DateTime @default(now())
}

model Patologia {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

model ConsultaMedica {
  id                        String   @id @default(uuid())
  cedula                    String
  nombreApellido            String
  registroId                String?  // UID del Registro (Censo) vinculado — null si no está en el censo
  genero                    String?
  edad                      Int?
  fechaNacimiento           String?  // yyyy-mm-dd; la edad se DERIVA de aquí (nunca manual)
  refugio                   String
  // Campos LEGADO (congelados, respaldo). El modelo por-ID usa las columnas *Ids de abajo.
  antecedentesPatologia     String?
  antecedentesMedicamentos  Json?    @default("[]") // LEGADO: [{nombre, dosis, periodo}]
  diagnosticoPatologia      String?
  diagnosticoMedicamentos   Json?    @default("[]") // LEGADO: [{nombre, dosis, periodo}]
  // ID-nativo:
  antecedentesPatologiaIds    Json?  @default("[]") // ["<PatologiaId>", ...]
  diagnosticoPatologiaIds     Json?  @default("[]") // ["<PatologiaId>", ...]
  antecedentesMedicamentoIds  Json?  @default("[]") // [{ id, dosis, periodo }]
  diagnosticoMedicamentoIds   Json?  @default("[]") // [{ id, dosis, periodo }]
  notasDoctor               String?
  createdAt                 DateTime @default(now())
  userId                    String
}

model MedicamentoPredefinido {
  id            String   @id @default(uuid())
  nombre        String   // principio activo (NO único por sí solo: se repite con distinta presentación)
  concentracion String   @default("") // ej: "500 MG", "200 MG / 5 ML"
  presentacion  String   @default("") // ej: "TABLETA", "JARABE", "INHALADOR"
  dosis         String   @default("") // dosis sugerida (puede quedar vacía)
  periodo       String   @default("") // período sugerido (puede quedar vacío)
  nota          String?
  createdAt     DateTime @default(now())

  @@unique([nombre, concentracion, presentacion])
}

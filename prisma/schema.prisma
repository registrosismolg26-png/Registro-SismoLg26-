// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registro {
  id                   String    @id @default(uuid())
  parroquia            String
  sector               String
  comunidad            String
  direccionExacta      String
  nombreApellido       String
  cedula               String    // única POR refugio (no global): ver @@unique abajo
  jefeFamilia          String    // "SI" / "NO"
  genero               String    // "MASCULINO" / "FEMENINO"
  fechaNacimiento      DateTime
  edad                 Int
  perteneceNucleo      String    // "SI" / "NO"
  cedulaJefeFamilia    String?
  estadoFisico         String    // "ILESO" / "LESIONADO"
  embarazo             String    @default("NO") // "SI" / "NO" (estado explícito de la persona)
  patologia            String    // "SI" / "NO"
  patologiaDescripcion String?
  gpsLat               Float?
  gpsLng               Float?
  telefono             String?
  cuarto               String?   // Assigned room: "EDIFICIO 1 SALON N"
  medicamentos         Json?     @default("[]") // LEGADO (congelado): [{nombre, dosis, periodo}] — reemplazado por medicamentoIds
  // NOTA: patologiaDescripcion (arriba) queda CONGELADO como respaldo; el modelo por-ID usa patologiaIds/medicamentoIds.
  patologiaIds         Json?     @default("[]") // ID-nativo: ["<PatologiaId>", ...]
  medicamentoIds       Json?     @default("[]") // ID-nativo: [{ id: "<MedicamentoPredefinidoId>", dosis, periodo }]
  retirado             String    @default("NO") // "SI" / "NO"
  retiradoRazon        String?
  retiradoFecha        DateTime?
  createdAt            DateTime  @default(now())
  syncedAt             DateTime? @default(now())
  intermitente         String    @default("NO") // "SI" or "NO"
  motivoIntermitente   String?   // Required when intermitente = "SI"
  refugio              String
  registrador          String?   // Nombre del operador que registró (se setea al censar; backfill desde AuditLog)

  // Una persona puede tener UNA fila por campamento (retirada en el de origen,
  // activa en el destino tras un traslado). La cédula ya NO es única global.
  @@unique([cedula, refugio])
  @@index([cedula])
  // Lecturas scoped por refugio ordenadas por fecha (GET /api/registros, ETag):
  // evita seq-scan al filtrar por refugio y ordenar/agrupar por createdAt.
  @@index([refugio, createdAt])
}

model Padron {
  cedula          String   @id // Ej: "12345678"
  nacionalidad    String   // "V" / "E"
  nombreCompleto  String
  sexo            String   // "M" / "F"
  fechaNacimiento DateTime
  parroquia       String   // Parroquia de votación

  @@index([parroquia])
}
model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  nombre                String
  password              String
  role                  String   // "MASTER" | "ADMIN" | "REGISTRADOR" | "VISUALIZADOR"
  campamentoTransitorio String
  createdAt             DateTime @default(now())
  // Telegram — canal de respaldo (códigos/avisos). chatId = destino del bot;
  // linkToken/expires = vinculación efímera (deep-link t.me/<bot>?start=<token>).
  telegramChatId        String?
  telegramLinkToken     String?
  telegramLinkExpires   DateTime?
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  keysAuth  String
  keysP256dh String
  createdAt DateTime @default(now())
}

model CustomRoom {
  id        String   @id @default(uuid())
  name      String
  refugio   String
  capacidad Int      @default(18) // camas disponibles en el salón
  createdAt DateTime @default(now())

  @@unique([name, refugio])
}

model Refugio {
  id        String   @id @default(uuid())
  nombre    String   @unique
  ubicacion String?  // URL de Google Maps del refugio (para el reporte)
  // Tipo de campamento: TRANSITORIO (asignación por habitación/cuarto, como hoy) |
  // ITINERANTE | MIXTO (asignación por Comunidad + Tipo de carpa + Nº, compuesta EN `cuarto`).
  tipo      String   @default("TRANSITORIO")
  createdAt DateTime @default(now())
}

// Catálogo de COMUNIDADES (refugios ITINERANTE/MIXTO): cada comunidad pertenece a una
// parroquia; en el censo se elige filtrada por la parroquia (paso Ubicación Geográfica).
// Administrable desde Config (Master). Sin auto-seed (carga inicial por SQL manual).
model Comunidad {
  id        String   @id @default(uuid())
  nombre    String
  parroquia String
  refugioId String?  // ID del Refugio dueño (scope por campamento, estable — no por nombre).
  // El censo muestra SOLO las comunidades de su campamento en la parroquia elegida → no
  // interfieren entre campamentos. NULL = sin asignar (no aparece en ningún desplegable).
  createdAt DateTime @default(now())

  @@unique([nombre, parroquia, refugioId])
  @@index([refugioId, parroquia])
}

// Catálogo de TIPOS DE CARPA (refugios ITINERANTE/MIXTO). Administrable (Config, Master).
model TipoCarpa {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

model Patologia {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

// Catálogo de tipos de lesión/herida (administrable por AdminMedico), análogo a
// Patologia. Se referencia por ID en ConsultaMedica.lesiones.
model TipoLesion {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

model ConsultaMedica {
  id                        String   @id @default(uuid())
  cedula                    String
  nombreApellido            String
  registroId                String?  // UID del Registro (Censo) vinculado — null si no está en el censo
  genero                    String?
  edad                      Int?
  fechaNacimiento           String?  // yyyy-mm-dd; la edad se DERIVA de aquí (nunca manual)
  // Tipo de atención: REFUGIADO (censado) | APOYO_INSTITUCIONAL | APOYO_COMUNITARIO | EMERGENCIA
  tipoPaciente              String?  @default("REFUGIADO")
  tipoNota                  String?  // nota opcional para atenciones de apoyo (institución, contexto…)
  // Fecha-hora REAL de la consulta (elegida a mano; puede diferir de createdAt =
  // sello de carga en sistema). Las vistas ordenan por ésta (fallback: createdAt).
  fechaConsulta             DateTime?
  // Lesiones / heridas / curas: [{ tipoId, zona, estado, cura }] (tipoId → TipoLesion).
  lesiones                  Json?    @default("[]")
  // Estados explícitos del paciente en ESTA consulta (auto-sugeridos por lesiones/
  // patologías, pero el médico decide). Se sincronizan al Registro del censo.
  estadoFisico              String?  // "ILESO" / "LESIONADO"
  embarazo                  String?  // "SI" / "NO"
  refugio                   String
  // Campos LEGADO (congelados, respaldo). El modelo por-ID usa las columnas *Ids de abajo.
  antecedentesPatologia     String?
  antecedentesMedicamentos  Json?    @default("[]") // LEGADO: [{nombre, dosis, periodo}]
  diagnosticoPatologia      String?
  diagnosticoMedicamentos   Json?    @default("[]") // LEGADO: [{nombre, dosis, periodo}]
  // ID-nativo:
  antecedentesPatologiaIds    Json?  @default("[]") // ["<PatologiaId>", ...]
  diagnosticoPatologiaIds     Json?  @default("[]") // ["<PatologiaId>", ...]
  antecedentesMedicamentoIds  Json?  @default("[]") // [{ id, dosis, periodo }]
  diagnosticoMedicamentoIds   Json?  @default("[]") // [{ id, dosis, periodo }]
  notasDoctor               String?
  createdAt                 DateTime @default(now())
  userId                    String

  // Lecturas scoped por refugio ordenadas por fecha (GET /api/consultas, ETag).
  @@index([refugio, createdAt])
}

// Reporte público compartido por link. El `id` es el token de la URL
// (/reporte/<id>). Solo expone estadísticas AGREGADAS del refugio indicado
// (sin PII). `refugio = null` → consolidado de todos (solo lo crea Master).
model ReporteCompartido {
  id              String          @id @default(cuid())
  refugio         String? // null = todos los refugios (solo Master)
  creadoPor       String // User.id que generó el link
  creadoPorNombre String // snapshot del nombre para mostrar "compartido por…"
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  accesos         ReporteAcceso[]

  @@index([creadoPor])
}

// Auditoría: se registra CADA apertura del reporte público (con o sin ubicación).
// Sin ubicación el reporte NO se muestra, pero el intento igual queda auditado.
model ReporteAcceso {
  id                 String            @id @default(uuid())
  reporteId          String
  reporte            ReporteCompartido @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  ip                 String?
  userAgent          String?
  lat                Float?
  lng                Float?
  precision          Float? // exactitud reportada por el navegador (metros)
  ubicacionConcedida Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@index([reporteId])
}

model MedicamentoPredefinido {
  id            String   @id @default(uuid())
  nombre        String   // principio activo (NO único por sí solo: se repite con distinta presentación)
  concentracion String   @default("") // ej: "500 MG", "200 MG / 5 ML"
  presentacion  String   @default("") // ej: "TABLETA", "JARABE", "INHALADOR"
  dosis         String   @default("") // dosis sugerida (puede quedar vacía)
  periodo       String   @default("") // período sugerido (puede quedar vacío)
  nota          String?
  createdAt     DateTime @default(now())

  @@unique([nombre, concentracion, presentacion])
}

// ── Caracterización (encuesta socioeconómica por familia) ───────────────────
// Extiende el censo SIN duplicarlo: reutiliza los datos generales de `Registro`
// (identidad, ubicación, GPS, salud básica, vínculo familiar) y solo añade lo
// NUEVO. Dos niveles: HOGAR (1 por familia, anclado al jefe) y PERSONA (1 por
// censado → consultable por persona). Las opciones cerradas viven en UN catálogo
// general (CaracterizacionOpcion), referenciado por ID (rename-safe).

// Catálogo general de opciones cerradas. Una sola tabla para TODAS las listas
// (no una tabla por catálogo): `modulo` agrupa en la UI de gestión, `campo`
// identifica la lista, `valor` es la opción visible.
model CaracterizacionOpcion {
  id        String   @id @default(uuid())
  modulo    String   // agrupador UI (ej. "VIVIENDA", "TRIAJE", "LABORAL")
  campo     String   // lista a la que pertenece (ej. "tenencia", "grupoSanguineo", "tallaCamisa")
  valor     String   // opción visible (ej. "PROPIA PAGADA")
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([modulo, campo, valor])
  @@index([modulo, campo])
}

// Datos del HOGAR: 1 por familia, anclado al Registro del jefe de familia.
model CaracterizacionHogar {
  id                  String    @id @default(uuid())
  jefeRegistroId      String    @unique // UID del Registro del jefe (ancla de la familia)
  familiaCedula       String // cédula del jefe (denormalizada, para agrupar/mostrar)
  refugio             String // denormalizado para el scope por refugio
  fechaIngresoRefugio DateTime?
  gpsViviendaLat      Float? // ubicación de la vivienda AFECTADA (distinta del refugio)
  gpsViviendaLng      Float?
  // Vivienda (ids de CaracterizacionOpcion; los SI/NO son explícitos)
  tenenciaId          String?
  misionVivienda      String? // "SI"/"NO"
  tipoViviendaId      String?
  materialId          String?
  nivelDanoId         String?
  estadoEnseresId     String?
  // Entorno (multi-select → arrays de ids)
  servicioAfectadoIds Json?     @default("[]")
  riesgoEntornoIds    Json?     @default("[]")
  // Socioeconómico del hogar (Fase 2)
  rangoIngresoId      String?
  recibeRemesas       String? // "SI"/"NO"
  recibeClap          String? // "SI"/"NO"
  accesoPatriaId      String?
  recibeBonosPatria   String? // "SI"/"NO"
  bonoContingenciaId  String?
  createdAt           DateTime  @default(now())
  syncedAt            DateTime? @default(now())

  @@index([refugio, createdAt])
}

// Datos de la PERSONA: 1 por censado (registroId). Consultable por persona
// (tipo de sangre, tallas, oficio…).
model CaracterizacionPersona {
  id                     String    @id @default(uuid())
  registroId             String    @unique // UID del Registro de la persona
  cedula                 String // denormalizada (lookup/scope)
  familiaCedula          String // cédula del jefe (ancla de familia → traer la ficha completa)
  refugio                String // denormalizado para el scope
  // Identidad extra + composición familiar (Módulo 3)
  estadoCivilId          String?
  correo                 String?
  telefonoAlt            String?
  parentescoId           String? // respecto al jefe de familia
  asisteEscuela          String? // "SI"/"NO"
  vulnerabilidadId       String?
  // Triaje extendido (Módulo 5)
  grupoSanguineoId       String?
  alergiaIds             Json?     @default("[]") // multi
  discapacidad           String? // "SI"/"NO"
  discapacidadTipoId     String?
  discapacidadDesc       String?
  vacunaAntitetanicaId   String?
  saludMental            String? // "SI"/"NO" (requiere apoyo psicológico)
  requiereAtencion       String? // "SI"/"NO" (atención médica inmediata)
  detalleAtencion        String?
  semanasGestacion       Int?
  // Antropometría / necesidades (Módulo 4)
  pesoKg                 Float?
  estaturaCm             Float?
  tallaCamisaId          String?
  tallaPantalonId        String?
  tallaCalzadoId         String?
  necesidadIds           Json?     @default("[]") // multi
  // Perfil laboral (Módulo 8, Fase 2)
  nivelEducativoId       String?
  impactoLaboralId       String?
  sectorEconomicoId      String?
  oficioId               String?
  aniosExperiencia       Int?
  rescatoHerramientas    String? // "SI"/"NO"/"PARCIAL"
  aptitudFisicaLaboralId String?
  disponibilidadId       String?
  puedeTrabajarInmediato String? // "SI"/"NO"
  validacionDestreza     String    @default("PENDIENTE") // PENDIENTE/APROBADA/RECHAZADA
  createdAt              DateTime  @default(now())
  syncedAt               DateTime? @default(now())

  @@index([refugio, createdAt])
  @@index([cedula])
  @@index([refugio, familiaCedula]) // traer todas las personas de una familia (ficha completa)
}

// Código de validación por correo (OTP) para acciones sensibles: crear/editar
// usuarios y cambiar contraseña. Se guarda el HASH del código (sha256), nunca el
// código en claro. `challengeId` = id. Expira a los 10 min; máx. 5 intentos.
model VerificationCode {
  id         String    @id @default(uuid())
  email      String // destinatario (minúsculas)
  codeHash   String // sha256 del código de 6 dígitos
  purpose    String // "USER_MUTATION" | "PASSWORD_CHANGE"
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([createdAt])
}

// Aviso in-app (centro de notificaciones). 1 fila POR destinatario (userId); se
// marca leído con readAt. Volumen bajo; cada usuario lista SOLO lo suyo.
model Notification {
  id        String    @id @default(uuid())
  userId    String // destinatario
  tipo      String // "USUARIO_NUEVO" | "TRASLADO" | "BIENVENIDA" | "AVISO"
  titulo    String
  cuerpo    String
  refugio   String? // campamento al que apunta (para el salto: Master cambia su viewRefugio)
  entidadId String? // id de la ficha a abrir al pulsar la acción (registroId / userId)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

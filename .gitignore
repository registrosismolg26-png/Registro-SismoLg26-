# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secreto del agente: API key de Resend para el correo-resumen tras cada push
.claude/resend.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ── Archivos de trabajo y datos con PII (NO versionar) ──────────────────────
# Datos personales derivados del censo/padrón. OJO: los .sql de ESQUEMA/migración
# viven en prisma/ y SÍ se versionan; esta regla solo ignora .sql sueltos en la raíz.
/*.xlsx
/*.csv
/*.docx
/*.sql
# Mockups/pruebas de UI y config local del previsualizador
/probar-*.html
/.claude/launch.json
# Scripts de preparación de datos de un solo uso (referencian archivos con PII)
/scripts/enrich-censo-mare.mjs
/scripts/actualizar-jefe-sql.mjs
